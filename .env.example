# Postgres connection string (e.g. from Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated origins allowed to call the API.
# Leave unset in development (allows any origin). Set it in production, e.g.
# ALLOWED_ORIGINS=https://ledger.example.com
ALLOWED_ORIGINS=*

# Set to 1 to log every SQL statement (noisy; development only)
SQL_ECHO=0
